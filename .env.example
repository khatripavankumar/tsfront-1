# Optional first-run account bootstrap. These values are hashed before storage.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-admin-password
CANDIDATE_EMAIL=candidate@example.com
CANDIDATE_PASSWORD=replace-with-a-long-candidate-password
PORT=3000

# Required for the live AI voice interview and its evidence-based evaluation.
# Keep this server-side; never expose it in browser JavaScript.
OPENAI_API_KEY=replace-with-your-openai-api-key
# Optional model overrides
OPENAI_REALTIME_MODEL=gpt-realt
ime
OPENAI_EVALUATION_MODEL=gpt-5-mini
